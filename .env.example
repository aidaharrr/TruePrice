# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (auth + scan limits): Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Apify API token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Optional: override the Amazon scraper actor (default: junglee/amazon-crawler)
# APIFY_ACTOR_ID=junglee/amazon-crawler

# SerpApi key (Google Lens reverse image search): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini key, free tier (image + title analysis): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: models tried in order when the primary times out (15 s), returns 503 (overloaded) or 404 (unavailable).
# Default: gemini-3.7-flash — set to empty to disable fallback.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash